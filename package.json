{
  "name": "loopi",
  "version": "0.1.0",
  "description": "issue 駆動の自動実装パイプライン（実装 → レビュー → PR → 最終レビュー → マージ）",
  "type": "module",
  "bin": {
    "loopi": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@openai/codex-sdk": "^0.154.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
